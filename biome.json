{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/.venv",
      "!**/node_modules",
      "!**/dist",
      "!**/src/lemming/web/mancha.js",
      "!**/test-results"
    ]
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "html": {
    "parser": {
      "interpolation": true
    }
  }
}
