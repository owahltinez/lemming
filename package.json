{
  "name": "lemming",
  "version": "0.1.0",
  "description": "Autonomous AI coding agent orchestrator",
  "type": "module",
  "scripts": {
    "postinstall": "npm run vendor",
    "test": "node --test src/lemming/web/*.test.js && playwright test --project=chromium",
    "screenshots": "playwright test --project=screenshots",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "mancha check src/lemming/web/*.html",
    "vendor": "cp node_modules/mancha/dist/mancha.js src/lemming/web/mancha.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@playwright/test": "^1.65.0",
    "jsdom": "^31.0.0",
    "mancha": "^0.30.0",
    "playwright": "^1.65.0"
  }
}
